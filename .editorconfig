root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

# cmd.exe is the interpreter here, not a text editor: a batch file with LF
# endings loses its labels, and `goto :failed` then falls through and runs the
# error path on success. CRLF is the interpreter's requirement, so it wins over
# the rule above.
[*.{bat,cmd}]
end_of_line = crlf
